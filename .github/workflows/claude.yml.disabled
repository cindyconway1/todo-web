# DISABLED 2026-10-27:
# This workflow allows users to prompt claude code in comments, PRs, etc
# by adding @claude. This was part of the POC, but not needed at this time.
# Leaving in in case we need to use it later
name: Claude Code

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]
  issues:
    types: [opened, assigned]
  pull_request_review:
    types: [submitted]

# Serialize @claude runs per PR/issue so overlapping runs don't push at the
# same time and clobber each other's commits (what caused the conflicts this
# branch exists to fix). A new run queues behind the in-progress one instead
# of cancelling it mid-work. Keyed on the PR/issue number, which is a stable
# proxy for the branch being worked on; the run_id fallback keeps unrelated
# runs from ever sharing a group.
concurrency:
  group: claude-${{ github.event.issue.number || github.event.pull_request.number || github.run_id }}
  cancel-in-progress: false

jobs:
  claude:
    # Two conditions must BOTH hold: the text says @claude, and the person saying
    # it is trusted. Without the second check anyone who can comment could summon
    # an agent
    #
    # author_association is filled in by GitHub on every comment/issue/review and
    # lives at a different path per event type, so the check is repeated per branch
    # rather than appended once.
    #
    # COLLABORATOR is included because this repo grants access directly rather than
    # through an org. Once this moves to an org, drop COLLABORATOR to limit @claude
    # to staff (OWNER/MEMBER) and keep outside collaborators from triggering it.
    if: |
      (
        github.event_name == 'issue_comment'
        && contains(github.event.comment.body, '@claude')
        && contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association)
      ) || (
        github.event_name == 'pull_request_review_comment'
        && contains(github.event.comment.body, '@claude')
        && contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association)
      ) || (
        github.event_name == 'pull_request_review'
        && contains(github.event.review.body, '@claude')
        && contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.review.author_association)
      ) || (
        github.event_name == 'issues'
        && (contains(github.event.issue.body, '@claude') || contains(github.event.issue.title, '@claude'))
        && contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.issue.author_association)
      )
    runs-on: ubuntu-latest

    # Timeout for the entire GitHub job (the Claude step has its own, below).
    timeout-minutes: 40

    permissions:
      contents: read
      pull-requests: read
      issues: write # write so the failure step below can comment on the issue/PR
      id-token: write
      actions: read # Required for Claude to read CI results on PRs
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1

      # Fetch the backend contract and regenerate the typed client BEFORE the agent
      # runs, so it works against the latest API instead of the checked-in (possibly
      # stale) schema.d.ts. Shared with ci.yml via a composite action.
      - id: regen
        uses: ./.github/actions/regen-api-client

      # If setup/fetch/regen failed, stop the run (the agent below is skipped because
      # the job is already failing) and tell the issue why — don't let the agent
      # silently hand-author against a stale or incomplete contract.
      - name: Report contract-fetch failure on the issue
        if: failure()
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const issue_number = context.issue.number;
            if (!issue_number) return;
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number,
              body: [
                '⚠️ **@claude did not run — the backend API contract could not be fetched.**',
                '',
                'The typed client (`src/api/schema.d.ts`) is regenerated from the backend\'s',
                '`api-schema-latest` release in `cindyconway1/todo-agentic-poc`. That download or',
                '`npm run gen:api` failed, so the workflow stopped rather than let the agent work',
                'against a stale or incomplete contract.',
                '',
                `See the [workflow run](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}) for the underlying error.`,
              ].join('\n'),
            });

      - name: Run Claude Code
        id: claude
        # timeout for this github step
        timeout-minutes: 30
        uses: anthropics/claude-code-action@d70510b174a1244958df0b03166a54912811f3e6 # v1, as of 2026-10-27
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}

          # This is an optional setting that allows Claude to read CI results on PRs
          additional_permissions: |
            actions: read

          # Optional: Give a custom prompt to Claude. If this is not specified, Claude will perform the instructions specified in the comment that tagged it.
          # prompt: 'Update the pull request description to include a summary of changes.'

          # --model no model provided so this will use the Claude Code default model
          #
          # Conflict self-healing: grant `git fetch` (+ the reset/rebase it feeds) but
          # DISALLOW `git pull`/`git merge`, so the agent reconciles a diverged branch
          # explicitly (fetch, then rebase onto — or reset --hard to — origin) instead
          # of an open-ended merge that can silently entangle another run's commits.
          # See https://github.com/anthropics/claude-code-action/blob/main/docs/usage.md
          #
          # Two cost ceilings that work together, capping two different bills:
          #   timeout-minutes (above) -- GitHub Actions minutes, billed per
          #       wall-clock minute the runner VM is up.
          #   --max-turns -- Claude usage, which is billed per token, but 
          #       turns are the CLI option provided
          # https://code.claude.com/docs/en/github-actions (see "Manage costs")
          claude_args: |
            --max-turns 40
            --allowedTools "Bash(npm ci),Bash(npm run lint),Bash(npm run test:unit),Bash(npm run type-check),Bash(npm run build),Bash(git fetch:*),Bash(git reset:*),Bash(git rebase:*)"
            --disallowedTools "Bash(git pull:*),Bash(npx:*),Bash(git merge:*)"
            --append-system-prompt "When a push is rejected because your branch has diverged from its remote (e.g. another @claude run pushed in the meantime), reconcile explicitly — never with `git pull` or `git merge`. Run `git fetch origin`, then `git rebase origin/<current-branch>` to replay your commits on top of the latest remote (resolve conflicts, then `git rebase --continue`). Use `git reset --hard origin/<current-branch>` only when you deliberately intend to discard local commits and let the remote win. Substitute the branch you are working on for <current-branch>."

